<style>
    :root {
        --csp-navy: #0B2545;
        --csp-navy-deep: #071a33;
        --csp-yellow: #F4B400;
        --csp-yellow-deep: #D99400;
        --csp-charcoal: #1F2937;
        --csp-paper: #F6F5F1;
        --csp-card: #FFFFFF;
        --csp-line: #E4E1D8;
        --csp-red: #B3261E;
        --csp-red-bg: #FBEAE9;
        --csp-green: #1E7B45;
        --csp-muted: #6B7280;
    }

    body {
        background: repeating-linear-gradient(135deg, rgba(11,37,69,0.02) 0 2px, transparent 2px 22px), var(--csp-paper);
        font-family: 'Inter', sans-serif;
        color: var(--csp-charcoal);
    }

    .csp-shell {
        max-width: 1040px;
        margin: 2.5rem auto 4rem;
    }

    /* ---------- Header band ---------- */
    .csp-header {
        background: linear-gradient(180deg, var(--csp-navy) 0%, var(--csp-navy-deep) 100%);
        border-radius: 14px 14px 0 0;
        padding: 1.9rem 2.25rem 1.6rem;
        position: relative;
        overflow: hidden;
        border-bottom: 6px solid var(--csp-yellow);
    }

        .csp-header::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(45deg, rgba(244,180,0,0.10) 0 14px, transparent 14px 28px);
            opacity: .5;
        }

    .csp-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: .14em;
        font-size: .72rem;
        color: var(--csp-yellow);
        text-transform: uppercase;
        position: relative;
        z-index: 1;
    }

    .csp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #fff;
        letter-spacing: .02em;
        line-height: 1.05;
        margin-top: .25rem;
        position: relative;
        z-index: 1;
    }

        .csp-title small {
            display: block;
            font-family: 'Inter',sans-serif;
            font-weight: 500;
            font-size: .95rem;
            color: #B9C4D6;
            letter-spacing: 0;
            margin-top: .35rem;
        }

    .csp-stamp {
        position: absolute;
        top: 1.4rem;
        right: 2rem;
        z-index: 2;
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        letter-spacing: .12em;
        font-size: 1rem;
        padding: .3rem .9rem;
        border-radius: 6px;
        transform: rotate(6deg);
        background: rgba(255,255,255,0.04);
    }

    /* ---------- Card shell ---------- */
    .csp-body {
        background: var(--csp-card);
        border-radius: 0 0 14px 14px;
        box-shadow: 0 18px 40px -22px rgba(11,37,69,0.35);
    }

    /* ---------- Section ---------- */
    .csp-section {
        border-bottom: 1px solid var(--csp-line);
        padding: 1.6rem 2.25rem;
        position: relative;
    }

        .csp-section:last-child {
            border-bottom: none;
        }

    .csp-section-tab {
        position: absolute;
        left: 0;
        top: 1.6rem;
        bottom: 1.6rem;
        width: 5px;
        border-radius: 3px;
    }

    .tab-info {
        background: var(--csp-navy);
    }

    .tab-risk {
        background: var(--csp-red);
    }

    .tab-docs {
        background: #c;
    }

    .tab-precaution {
        background: #1D6FA5;
    }

    .tab-inspect {
        background: #5B4B8A;
    }

    .tab-ppe {
        background: var(--csp-yellow-deep);
    }

    .tab-signoff {
        background: var(--csp-green);
    }

    .csp-section-heading {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.28rem;
        letter-spacing: .03em;
        color: var(--csp-navy);
        text-transform: uppercase;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .border-section {
        border: 1px solid #DAA464;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
        background: #fffde6;

        .csp-section-heading .num {
            font-family: 'JetBrains Mono',monospace;
            font-size: .75rem;
            color: #fff;
            background: var(--csp-navy);
            border-radius: 4px;
            padding: .15rem .45rem;
            letter-spacing: 0;
        }

    .csp-label {
        font-size: .72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--csp-muted);
        margin-bottom: .3rem;
    }

    .form-control, .form-select {
        border: 1px solid #D9D6CC;
        border-radius: 8px;
        font-size: .92rem;
        padding: .5rem .7rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--csp-navy);
            box-shadow: 0 0 0 .2rem rgba(11,37,69,0.12);
        }

    textarea.form-control {
        min-height: 80px;
    }

    .mono-input {
        font-family: 'JetBrains Mono', monospace;
    }

    /* ---------- Risk chips ---------- */
    .csp-risk-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: .6rem;
    }

    @@media (max-width:768px) {
        .csp-risk-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    .risk-chip {
        border: 1.5px solid var(--csp-line);
        border-radius: 10px;
        padding: .55rem .75rem;
        display: flex;
        align-items: center;
        gap: .55rem;
        font-size: .88rem;
        font-weight: 500;
        background: #FCFBF8;
        transition: .15s;
    }

        .risk-chip:has(input:checked) {
            border-color: var(--csp-red);
            background: var(--csp-red-bg);
            color: var(--csp-red);
            font-weight: 600;
        }

        .risk-chip input {
            accent-color: var(--csp-red);
            width: 1.05rem;
            height: 1.05rem;
        }

    /* ---------- PPE chips ---------- */
    .ppe-chip:has(input:checked) {
        border-color: var(--csp-yellow-deep);
        background: #FFF6E1;
        color: #8A6300;
        font-weight: 600;
    }

    .ppe-chip input {
        accent-color: var(--csp-yellow-deep);
        width: 1.05rem;
        height: 1.05rem;
    }

    /* ---------- Yes/No/NA segmented control ---------- */
    .csp-ynq {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .65rem .9rem;
        border: 1px solid var(--csp-line);
        border-radius: 10px;
        background: #FCFBF8;
        margin-bottom: .55rem;
    }

    .csp-ynq-text {
        font-size: .88rem;
        font-weight: 500;
        flex: 1;
    }

    .csp-seg {
        display: inline-flex;
        border: 1px solid #D9D6CC;
        border-radius: 8px;
        overflow: hidden;
        flex-shrink: 0;
    }

        .csp-seg label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .05em;
            padding: .35rem .7rem;
            margin: 0;
            cursor: pointer;
            background: #fff;
            color: var(--csp-muted);
            border-right: 1px solid #D9D6CC;
        }

            .csp-seg label:last-child {
                border-right: none;
            }

        .csp-seg input {
            display: none;
        }

            .csp-seg input:checked + label {
                background: var(--csp-navy);
                color: #fff;
            }

    /* ---------- Inspection table ---------- */
    .csp-table thead th {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--csp-muted);
        border-bottom: 2px solid var(--csp-navy);
        background: #F9F8F4;
    }

    .csp-table td {
        vertical-align: middle;
    }

    .csp-table input.form-control {
        font-size: .85rem;
        padding: .35rem .55rem;
    }

    /* ---------- Sign-off ---------- */
    .signoff-card {
        border: 1px solid var(--csp-line);
        border-radius: 10px;
        padding: 1.1rem 1.2rem;
        background: #FCFBF8;
        height: 100%;
    }

        .signoff-card .role {
            font-family: 'Barlow Condensed',sans-serif;
            font-weight: 700;
            color: var(--csp-navy);
            font-size: 1.05rem;
            margin-bottom: .15rem;
        }

        .signoff-card p {
            font-size: .82rem;
            color: var(--csp-muted);
            margin-bottom: .75rem;
        }

    .sig-line {
        border-bottom: 1.5px dashed #BFC4CC;
        height: 2.4rem;
        margin-bottom: .3rem;
    }

    .csp-footer-actions {
        padding: 1.4rem 2.25rem 2rem;
        display: flex;
        gap: .75rem;
        justify-content: flex-end;
        background: #F9F8F4;
        border-radius: 0 0 14px 14px;
    }

    .btn-csp-primary {
        background: var(--csp-navy);
        border-color: var(--csp-navy);
        color: #fff;
        font-weight: 600;
        padding: .55rem 1.4rem;
        border-radius: 8px;
    }

        .btn-csp-primary:hover {
            background: var(--csp-navy-deep);
            border-color: var(--csp-navy-deep);
            color: #fff;
        }

    .btn-csp-outline {
        border: 1.5px solid var(--csp-navy);
        color: var(--csp-navy);
        font-weight: 600;
        padding: .55rem 1.4rem;
        border-radius: 8px;
        background: #fff;
    }

        .btn-csp-outline:hover {
            background: var(--csp-navy);
            color: #fff;
        }

    .required-star {
        color: darkred;
    }
</style>

<div class="csp-shell">
    <form asp-action="ConfinedSpaceEntry" method="post" asp-controller="Home">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="card-header text-center fw-bold">
            CONFINED SPACE TO ENTRY PERMIT
        </div>

        <!-- BASIC DETAILS -->

        <section class="border-section">
            @Html.ValidationMessage("BasicDetails", "", new { @class = "text-danger" })
            <div class="section-title">
                Basic Details <span class="required-star">*</span>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <label>Unit</label>
                    @Html.TextBoxFor(m => m.Unit, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label>Contractor/Internal Team</label>
                    @Html.TextBoxFor(m => m.Contractor, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Contractor, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label>Location</label>
                    @Html.TextBoxFor(m => m.Location, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label>Number of Workmen Involved</label>
                    @Html.TextBoxFor(m => m.NoOfWorkmen, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.NoOfWorkmen, "", new { @class = "text-danger" })
                </div>
            </div>
        </section>

        <!-- DATE & TIME -->

        <section class="border-section">
            @Html.ValidationMessage("DateTime", "", new { @class = "text-danger" })
            <div class="section-title">
                Date & Time <span class="required-star">*</span>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <label>Starting From Date</label>
                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label>Starting From Time</label>
                    @Html.TextBoxFor(m => m.StartTime, new { type = "time", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.StartTime, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label>Expected Completion Date</label>
                    @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label>Expected Completion Time</label>
                    @Html.TextBoxFor(m => m.EndTime, new { type = "time", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.EndTime, "", new { @class = "text-danger" })
                </div>
            </div>
        </section>

        <!-- WORK DESCRIPTION -->

        <section class="border-section">
            @Html.ValidationMessage("WorkDescription", "", new { @class = "text-danger" })
            <div class="section-title mt-3">
                Work Description <span class="required-star">*</span>
                @Html.TextAreaFor(m => m.WorkDescription, 2, 100, new { @class = "form-control" })
            </div>
        </section>

        <!-- TOOLS/EQUIPMENT -->

        <section class="border-section">
            <div class="section-title mt-3">
                Tools/Equipment to be used
            </div>
            @Html.TextAreaFor(m => m.ToolsEquipment, 2, 100, new { @class = "form-control" })
        </section>

        <!-- RISK -->

        <section class="border-section">
            @Html.ValidationMessage("Risk", "", new { @class = "text-danger" })
            <div class="section-title">
                Identify Risks Associated with Work <span class="required-star">*</span>
            </div>
            <div class="row">
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskOxygen, new { @class = "form-check-input" })
                    <label>Lack of Oxygen</label>
                </div>
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskExplosion, new { @class = "form-check-input" })
                    <label>Explosion</label>
                </div>
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskFume, new { @class = "form-check-input" })
                    <label>Fume/Vapor</label>
                </div>
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskNoise, new { @class = "form-check-input" })
                    <label>Noise</label>
                </div>
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskHot, new { @class = "form-check-input" })
                    <label>Hot</label>
                </div>
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskFire, new { @class = "form-check-input" })
                    <label>Fire</label>
                </div>
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskDust, new { @class = "form-check-input" })
                    <label>Dust</label>
                </div>
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.RiskVibration, new { @class = "form-check-input" })
                    <label>Vibration</label>
                </div>

                <div class="col-md-6">
                    <label>Other (Specify)</label>
                    <input type="text" name="OtherRisk" class="form-control others-input" />
                </div>
            </div>
        </section>

        <!-- ATTACH DOCUMENTS -->

        <section class="border-section">
            <div class="section-title">Documents to Attach</div>
            <div class="row">
                <div class="col-md-2">
                    @Html.CheckBoxFor(m => m.JSA, new { id = "jsa" })
                    <label>JSA</label>
                </div>
                <div class="col-md-2">
                    @Html.CheckBoxFor(m => m.RiskAssessment, new { id = "jsa" })
                    <label>Risk Assessment</label>
                </div>
                <div class="col-md-4">
                    <label>Other (Specify)</label>
                    <input type="text" name="DocumentOther" class="form-control others-input" />
                </div>
            </div>
        </section>

        <!-- PRECAUTION -->

        <section class="border-section">
            <div class="section-title">
                Precaution required to complete the work safety
            </div>

            <div class="row">
                <div class="col-md-6">
                    <label>Are atmospheric inspection made ?</label>
                </div>
            </div>

            <div class="col-md-6">
                @Html.CheckBoxFor(m => m.IsOxygenLevelchecked)
                <label>
                    Oxygen : 
                </label>
                @Html.TextBoxFor(m => m.OxygenLevel, new { @class = "form-control" }) % (19.5 - 23.5 %)
            </div>

            <div class="row mt-2">

                <div class="col-md-6">
                    @Html.CheckBoxFor(m => m.IsExplosiveLevelChecked)
                    <label>
                        Explosive :
                    </label>
                    @Html.TextBoxFor(m => m.ExplosiveLevel, new { @class = "form-control" }) % LEL (Less than 10%)
                </div>
            </div>

            <div class="row mt-2">

                <div class="col-md-6">
                    @Html.CheckBoxFor(m => m.IsCOLevelChecked)
                    <label>
                        CO :
                    </label>
                    @Html.TextBoxFor(m => m.COLevel, new { @class = "form-control" }) PPM (less than 35 PPM -8hr)
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    @Html.CheckBoxFor(m => m.IsH2SLevelChecked)
                    <lable>
                        H2S : 
                    </lable>
                    @Html.TextBoxFor(m => m.H2SLevel, new { @class = "form-control" }) PPM (less than 10PPM - 8hr)
                </div>
            </div>

            <!-- Precaution: Atmospheric Inspection -->

            <div>
                Has appropriate ventilation provided after atmospheric inspection made?
            </div>
            <div class="row mb-2">
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.Natural)
                    <label>Natural</label>
                </div>

                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.Mechanical)
                    <label>Mechanical</label>
                </div>

                <div class="col-md-3">
                    <label>State Details : </label>
                    @Html.TextBoxFor(m => m.StateDetails, new { @class = "form-control" })
                </div>
            </div>

            <!-- Precaution: Communication -->

            <div class="row mb-2">
                <div class="col-md-12">
                    <label>Is appropriate communication system in place?</label>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-2">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.Communication, "Yes", new { @class = "form-check-input", id = "safeYes" })
                        <label class="form-check-label" for="safeYes">Yes</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.Communication, "No", new { @class = "form-check-input", id = "safeNo" })
                        <label class="form-check-label" for="safeNo">No</label>
                    </div>
                </div>
            </div>

            <!-- Precaution: Emergency Procedure -->

            <div class="row mb-2">
                <div class="col-md-12">
                    <label>Are entrant and attendant very well known about emergency procedure?</label>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-2">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.EmergencyProcedure, "Yes", new { @class = "form-check-input", id = "safeYes" })
                        <label class="form-check-label" for="safeYes">Yes</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.EmergencyProcedure, "No", new { @class = "form-check-input", id = "safeNo" })
                        <label class="form-check-label" for="safeNo">No</label>
                    </div>
                </div>
            </div>

            <!-- Precaution: Hotwork Required -->

            <div class="row mb-2">
                <div class="col-md-12">
                    <label>Does the work require access to hot work?</label>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-2">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.HotWorkRequired, "Yes", new { @class = "form-check-input", id = "safeYes" })
                        <label class="form-check-label" for="safeYes">Yes</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.HotWorkRequired, "No", new { @class = "form-check-input", id = "safeNo" })
                        <label class="form-check-label" for="safeNo">No</label>
                    </div>
                </div>
            </div>

            <!-- Precaution: Lockout -->

            <div class="row mb-2">
                <div class="col-md-12">
                    <label>If required, lockout /Tagout system is followed?</label>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-2">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.Lockout, "Yes", new { @class = "form-check-input", id = "safeYes" })
                        <label class="form-check-label" for="safeYes">Yes</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-check">
                        @Html.RadioButtonFor(m => m.Lockout, "No", new { @class = "form-check-input", id = "safeNo" })
                        <label class="form-check-label" for="safeNo">No</label>
                    </div>
                </div>
            </div>

        </section>

        <!-- EMERGENCY TEAM -->

        <section class="border-section">
            <div class="section-title">
                Emergency Team
            </div>
            <div class="form-group mt-2">
                <label>Contact Numbers:</label>
                <div class="col-md-3">
                    @Html.TextBoxFor(m => m.Contact1, new { @class = "form-control", placeholder = "1." })
                    @Html.TextBoxFor(m => m.Contact2, new { @class = "form-control", placeholder = "2." })
                    @Html.TextBoxFor(m => m.Contact3, new { @class = "form-control", placeholder = "3." })
                </div>
                <div class="col-md-4">
                    <label>Other (Specify)</label>
                    <input type="text" name="Other" class="form-control others-input" />
                </div>
            </div>
        </section>

        <!-- INSURANCE -->

        <section class="border-section">
            @Html.ValidationMessage("Insurance", "", new { @class = "text-danger" })
            <div class="section-title">
                Insurance / WC / ESI Copy available for Workmen <span class="required-star">*</span>
            </div>

            <div class="row align-items-center">
                <div class="col-md-3 d-flex align-items-center gap-2">
                    @Html.CheckBoxFor(m => m.WC, new { id = "wc" })
                    <label>WC</label>
                    <div id="wcUpload" style="display:none;">
                        <input type="file" name="WCFile" id="wcFile" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-3 d-flex align-items-center gap-2">
                    @Html.CheckBoxFor(m => m.ESI, new { id = "esi" })
                    <label>ESI</label>

                    <div id="esiUpload" style="display:none;">
                        <input type="file" name="ESIFile" id="esiFile" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label>Other (Specify)</label>
                    <input type="text" name="OtherInsurance" class="form-control" />
                </div>
            </div>
        </section>

        <!-- INSPECTION -->

        <section class="border-section">
            @Html.ValidationMessage("Inspection", "", new { @class = "text-danger" })
            <div class="section-title">
                The following areas / items have been inspected by issuer and receiver  <span class="required-star">*</span>
            </div>

            <div class="row">

                <!-- Fire Extinguisher -->
                <div class="col-md-3">
                    @Html.CheckBoxFor(m => m.FireExtinguisher)
                    <label>Fire Extinguisher</label>
                </div>

                <div class="col-md-3">
                    <label>Type</label>
                    @Html.TextBoxFor(m => m.FireExtinguisherType, new { @class = "form-control form-control-sm" })
                </div>

                <div class="col-md-3">
                    <label>Quantity</label>
                    @Html.TextBoxFor(m => m.FireExtinguisherQty, new { @class = "form-control form-control-sm" })
                </div>

                <div class="col-md-3">
                    <label>Size</label>
                    @Html.TextBoxFor(m => m.FireExtinguisherSize, new { @class = "form-control form-control-sm" })
                </div>

                <!-- Other Inspection Items -->
                <div class="col-md-3 mt-3">
                    @Html.CheckBoxFor(m => m.Access) <label>Access / Escape Route</label>
                </div>

                <div class="col-md-3 mt-3">
                    @Html.CheckBoxFor(m => m.DangerWarningSign) <label>Danger / Warning Sign</label>
                </div>

                <div class="col-md-3 mt-3">
                    @Html.CheckBoxFor(m => m.Lighting) <label>Lighting</label>
                </div>

                <div class="col-md-3 mt-3">
                    @Html.CheckBoxFor(m => m.LogBook) <label>Log Book Register</label>
                </div>

                <div class="col-md-3 mt-3">
                    @Html.CheckBoxFor(m => m.GasDetector) <label>Gas Detector</label>
                </div>

                <div class="col-md-4">
                    <label>Other (Specify)</label>
                    <input type="text" name="InspectionOther" class="form-control" />
                </div>
            </div>
        </section>

        <!-- PPE -->

        <section class="border-section">
            @Html.ValidationMessage("PPE", "", new { @class = "text-danger" })
            <div class="section-title">
                PPE Required for Activity <span class="required-star">*</span>
            </div>
            <div class="row">
                <div class="col-md-3">@Html.CheckBoxFor(m => m.Helmet) <label>Helmet</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.SafetyShoes) <label>Safety Shoes</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.Gloves) <label>Mechanical Gloves</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.EarPlugs) <label>Safety Ear Plugs/muff</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.Goggles) <label>Safety Goggles</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.Vest) <label>Reflective Vest</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.GasMask) <label>Gas Mask</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.Harness) <label>Safety Harness</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.Gumboot) <label>Gumboot</label></div>
                <div class="col-md-3">@Html.CheckBoxFor(m => m.DustMask) <label>Dust Mask</label></div>

                <div class="col-md-3">
                    <label>Other (Specify)</label>
                    <input type="text" name="PPEOther" class="form-control others-input" />
                </div>
            </div>
        </section>

        <!-- ISSUES & ACCEPTANCE -->

        <section class="border-section">
            <div class="section-title">
                Issue & Acceptance
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label>Raised By</label>
                    @Html.TextBoxFor(m => m.RaisedBy, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    <label>Department Incharge</label>
                    @Html.TextBoxFor(m => m.DepartmentIncharge, new { @class = "form-control" })
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-6">
                    <label>Facility</label>
                    @Html.TextBoxFor(m => m.Facility, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    <label>Safety</label>
                    @Html.TextBoxFor(m => m.Safety, new { @class = "form-control" })
                </div>
            </div>
        </section>

        <!-- SUSPENSION -->

        <section class="border-section">
            @Html.ValidationMessage("Suspension", "", new { @class = "text-danger" })
            <div class="section-title">
                Suspension <span class="required-star">*</span>
            </div> 
            <label>This permit is suspended, area/equipment is not safe to use.</label>
            <div class="row mt-2">
                <div class="col-md-6">
                    <label>Name</label>
                    @Html.TextBoxFor(m => m.SuspensionName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SuspensionName, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label>Signature / Date</label>
                    @Html.TextBoxFor(m => m.SuspensionDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SuspensionDate, "", new { @class = "text-danger" })
                </div>
            </div>
        </section>

        <!-- APPROVER DETAILS -->

        <section class="border-section">
            @Html.ValidationMessage("ApproverDetails", "", new { @class = "text-danger" })
            <div class="section-title">
                Approver Details <span class="required-star">*</span>
            </div>
            <section class="permit-section">
                <div class="row">
                    <div class="col-lg-3">
                        <label>
                            Approver One Email
                        </label>
                        @Html.TextBoxFor(m => m.ApproverOne, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ApproverOne, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-lg-3">
                        <label>Approver Two Email</label>
                        @Html.TextBoxFor(m => m.ApproverTwo, new { @class = "form-control" })
                    </div>
                    <div class="col-lg-3">
                        <label>Approver Three Email</label>
                        @Html.TextBoxFor(m => m.ApproverThree, new { @class = "form-control" })
                    </div>
                    <div class="col-lg-3">
                        <label>Approver Four Email</label>
                        @Html.TextBoxFor(m => m.ApproverFour, new { @class = "form-control" })
                    </div>
                </div>
            </section>
        </section>

        <!-- BUTTON -->

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success px-5">Save</button>
            <button type="button" onclick="window.print()" class="btn btn-secondary px-4 ms-2">Print</button>
        </div>

    </form>
</div>
