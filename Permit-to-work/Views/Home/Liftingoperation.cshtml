@model LiftingOperationPermit

@{
    ViewData["Title"] = "Lifting Operation Permit";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Lifting Operation Permit</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            background-color: #f5f8fa;
            padding: 10px;
        }


        .card {
            border: 2px solid #add8e6;
            border-radius: 10px;
            margin-bottom: 20px;
            padding: 20px;
            margin-left: 7%;
            margin-right: 7%;
            background-color: #d4e6f1;

        .others-input {
        margin-top: 5px;
        }
       
        .border-section {
            border: 1px solid #add8e6;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 15px;
            background: #eef7fb;
        }

        .section-title {
        background: #B8EAF2;
        font-weight: bold;
        padding: 6px 10px;
        margin-bottom: 10px;
        border: 1px solid #7FD7E3;
        color: #3e2723; 
        border-radius: 4px;

        .btn-success {
        background-color: #add8e6; /* bright yellow button */
        border-color: #d4e6f1;
        color: #ffffff;
        }

        .btn-success:hover {
        background-color: #d4e6f1;
        border-color: #add8e6;
        }

        .required-star {
        color: darkred;
        }


        .form-check {
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 250px; 
        }

    </style>
</head>

<body>

    <form method="post" action="/Home/Liftingoperation">

        @* <section class="sticky-header text-center py-3 pt-3">
            <h3 class="fw-bold">LIFTING OPERATION PERMIT</h3>
        </section> *@

        <div class="card">
            <div class="card-header text-center fw-bold">
                LIFTING OPERATION PERMIT
            </div>

            <!-- ════════════════════════════════════════════════════
               SECTION: BASIC DETAILS
            ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Basic Details", "", new { @class = "text-danger" })
                <div class="section-title">
                    Basic Details <span class="required-star">*</span>
                </div>
               @*  <div class="row"> *@

                <div class="row g-3">
                    <div class="col-md-3">
                        <label>
                            Unit <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.Unit, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Contractor <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.ContractorName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ContractorName, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Location <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.Location, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            No. of Workmen involved <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.NoOfWorkmen, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NoOfWorkmen, "", new { @class = "text-danger" })
                    </div>
                </div>
            </section>

            <!-- ════════════════════════════════════════════════════
               SECTION: DATE & TIME
            ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Dates", "", new { @class = "text-danger" })
                <div class="section-title">
                    Date and Time <span class="required-star">*</span>
                </div>
                <div class="row">

                @* <div class="row g-3"> *@

                    <div class="col-md-3">
                        <label>
                            Starting From Date <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Starting From Time<span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.StartTime, new { type = "time", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.StartTime, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Expected Completion Date <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Expected Completion Time<span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.EndTime, new { type = "time", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.EndTime, "", new { @class = "text-danger" })
                    </div>
                </div>
                </section>
            
               
                <!-- ════════════════════════════════════════════════════
               SECTION: LIFTING EQUIPMENT
                ════════════════════════════════════════════════════ -->
                <section class="card permit-card">
                    @Html.ValidationMessage("Lifting Equipment", "", new { @class = "text-danger" })
                    <div class="section-title">
                        Lifting Equipment <span class="required-star">*</span>
                    </div>
                    <div class="row">

                        <div class="col-md-3 form-check">
                            @Html.CheckBoxFor(m => m.TruckMounted, new { @class = "form-check-input" })
                            <label class="form-check-label">Truck Mounted</label>
                        </div>

                        <div class="col-md-3 form-check">
                            @Html.CheckBoxFor(m => m.HydraCrane, new { @class = "form-check-input" })
                            <label class="form-check-label">Hydra Crane</label>
                        </div>

                        <div class="col-md-3 form-check">
                            @Html.CheckBoxFor(m => m.OverheadCrane, new { @class = "form-check-input" })
                            <label class="form-check-label">Overhead Crane</label>
                        </div>

                        <div class="col-md-3 form-check">
                            @Html.CheckBoxFor(m => m.TowerCrane, new { @class = "form-check-input" })
                            <label class="form-check-label">Tower Crane</label>
                        </div>
                    </div>
                    </section>

           
            <!-- ════════════════════════════════════════════════════
               SECTION: LOAD DETAILS
            ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Details of Load", "", new { @class = "text-danger" })
                <div class="section-title">
                    Details of Load <span class="required-star">*</span>
                </div>
                <div class="row">

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.WeightApprox, new { @class = "form-check-input" })
                        <label class="form-check-label">Weight</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.DimensionMax, new { @class = "form-check-input" })
                        <label class="form-check-label">Dimension</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.Quantity, new { @class = "form-check-input" })
                        <label class="form-check-label">Quantity</label>
                    </div>
                </div>
            </section>

            <!-- ════════════════════════════════════════════════════
               SECTION: RIGGER
          ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Rigger", "", new { @class = "text-danger" })
                <div class="section-title">
                    Rigger
                </div>
                <div class="form-check">
                    @Html.RadioButtonFor(m => m.RiggerLevel, "LessThan10Ton", new { @class = "form-check-input", id = "Level3" })
                    <label class="form-check-label" for="Level3">
                        Less than 10 Ton (Level 3)
                    </label>
                </div>

                <div class="form-check">
                    @Html.RadioButtonFor(m => m.RiggerLevel, "Between10And40Ton", new { @class = "form-check-input", id = "Level2" })
                    <label class="form-check-label" for="Level2">
                        10–40 Ton (Level 2)
                    </label>
                </div>

                <div class="form-check">
                    @Html.RadioButtonFor(m => m.RiggerLevel, "MoreThan40Ton", new { @class = "form-check-input", id = "Level1" })
                    <label class="form-check-label" for="Level1">
                        More than 40 Ton (Level 1)
                    </label>
                </div>

                @Html.ValidationMessageFor(m => m.RiggerLevel, "", new { @class = "text-danger" })
           
        </section>
        

            <!-- ════════════════════════════════════════════════════
               SECTION: Equipment & Work Details
          ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Equipment & Work Details", "", new { @class = "text-danger" })
                <div class="section-title">
                    Equipment & Work Details 
                </div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label>
                            Serial No
                        </label>
                        @Html.TextBoxFor(m => m.SerialNo, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.SerialNo, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Inspection Date
                        </label>
                        @Html.TextBoxFor(m => m.InspectionDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.InspectionDate, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3">
                        <label>
                            Capacity 
                        </label>
                        @Html.TextBoxFor(m => m.CapacitySWL, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.CapacitySWL, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        <label>
                            Work Description 
                        </label>
                        @Html.TextBoxFor(m => m.WorkDescription, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.WorkDescription, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Tools
                        </label>
                        @Html.TextBoxFor(m => m.ToolsEquipment, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ToolsEquipment, "", new { @class = "text-danger" })
                    </div>
                </div>
            </section>


          <!-- ════════════════════════════════════════════════════
           SECTION: RISK
          ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Risk", "", new { @class = "text-danger" })
                <div class="section-title">
                    Identify Risks associated with this Hot Work <span class="required-star">*</span>
                </div>
                <div class="row">

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskToppling, new { @class = "form-check-input" })
                        <label class="form-check-label">Toppling/Tip Over/Turn Over</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskSuspendedLoad, new { @class = "form-check-input" })
                        <label class="form-check-label">Suspended Load</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskHighWind, new { @class = "form-check-input" })
                        <label class="form-check-label">High Wind</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskMovingVehicle, new { @class = "form-check-input" })
                        <label class="form-check-label">Moving Vehicle/Equipment</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskFallingObjects, new { @class = "form-check-input" })
                        <label class="form-check-label">Falling Objects</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskOverLoad, new { @class = "form-check-input" })
                        <label class="form-check-label">Over load</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskTripping, new { @class = "form-check-input" })
                        <label class="form-check-label">Tripping / Slipping</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskNoise, new { @class = "form-check-input" })
                        <label class="form-check-label">Noise</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskCrushing, new { @class = "form-check-input" })
                        <label class="form-check-label">Crushing</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskCollapse, new { @class = "form-check-input" })
                        <label class="form-check-label">Collapse</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskNearOverheadLines, new { @class = "form-check-input" })
                        <label class="form-check-label">Near Overhead Lines</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskTraffic, new { @class = "form-check-input" })
                        <label class="form-check-label">Traffic</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.RiskAdverseWeather, new { @class = "form-check-input" })
                        <label class="form-check-label">Adverse Weather</label>
                    </div>

                    <div class="col-md-3">
                        <label>Other (specify):</label>
                        @Html.TextBoxFor(m => m.OtherRisk, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.OtherRisk, "", new { @class = "text-danger" })
                    </div>
                </div>
            </section>

              
            <!-- ════════════════════════════════════════════════════
               SECTION: DOCUMENTS
          ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                <div class="section-title">Documents to attach</div>

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.AttachJSA, new { @class = "form-check-input", id = "jsa" })
                            <label class="form-check-label" for="jsa">JSA</label>
                        </div>

                        <div id="jsaList" style="display:none; max-height:150px; overflow-y:auto; border:1px solid #ccc; padding:8px;">

                            <div><input type="checkbox" id="jsa_cutting"> Cutting machine</div>
                            <div><input type="checkbox" id="jsa_excavation"> Excavation</div>
                            <div><input type="checkbox" id="jsa_welding"> Welding</div>
                            <div><input type="checkbox" id="jsa_electrical"> Electrical Work</div>
                            <div><input type="checkbox" id="jsa_Height"> Height Work</div>
                            <div><input type="checkbox" id="jsa_plumbing"> plumbing</div>
                            <div><input type="checkbox" id="jsa_cable"> cable Routing</div>
                            <div><input type="checkbox" id="jsa_Lifting"> Lifting</div>
                            <div><input type="checkbox" id="jsa_Machine"> Machine maintenance</div>
                        </div>
                    </div>
                    </div>

             
              
                    <div class="mb-2">
                        <label class="form-label">Are all combustible materials removed or shielded from sparks?</label>
                        <div class="d-flex gap-3">
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.CombustibleMaterialsRemoved, "Y", new { @class = "form-check-input", id = "comb_yes" })
                                <label class="form-check-label" for="comb_yes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.CombustibleMaterialsRemoved, "N", new { @class = "form-check-input", id = "comb_no" })
                                <label class="form-check-label" for="comb_no">No</label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.CombustibleMaterialsRemoved, "NA", new { @class = "form-check-input", id = "comb_na" })
                                <label class="form-check-label" for="comb_na">N/A</label>
                            </div>
                        </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Are all combustible materials removed or shielded from sparks EquipmentCertified?</label>
                            <div class="d-flex gap-3">
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.EquipmentCertified, "Y", new { @class = "form-check-input", id = "comb_yes" })
                                    <label class="form-check-label" for="comb_yes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(m => m.EquipmentCertified, "N", new { @class = "form-check-input", id = "comb_no" })
                                    <label class="form-check-label" for="comb_no">No</label>
                                </div>
                            </div>
                        </div>
                    </section>
                     

                <!-- ════════════════════════════════════════════════════
               SECTION: RIGGING
          ════════════════════════════════════════════════════ -->
                <section class="card permit-card">
                    @Html.ValidationMessage("RIGGING", "", new { @class = "text-danger" })
                    <div class="section-title">
                        Rigging Accessories
                    </div>
                    <div class="row">

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.WireRope, new { @class = "form-check-input" })
                            <label class="form-check-label">Wire Rope</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.WebSling, new { @class = "form-check-input" })
                            <label class="form-check-label">Web Sling</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.ChainSling, new { @class = "form-check-input" })
                            <label class="form-check-label">Chain Sling</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.Shackles, new { @class = "form-check-input" })
                            <label class="form-check-label">Shackles</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.EyeBolt, new { @class = "form-check-input" })
                            <label class="form-check-label">Eye Bolt</label>
                        </div>

                        <div class="col-md-3">
                            <label>Other (specify):</label>
                            @Html.TextBoxFor(m => m.OtherRigging, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.OtherRigging, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </section>

                <!-- ════════════════════════════════════════════════════
               SECTION:  LOAD CHECK
               ════════════════════════════════════════════════════ -->
                <section class="card permit-card">
                    @Html.ValidationMessage("Load & Wind Check", "", new { @class = "text-danger" })
                    <div class="section-title">
                        Load & Wind Check
                    </div>
                    <div class="row">

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.LoadChartChecked, new { @class = "form-check-input" })
                            <label class="form-check-label">Load Chart Checked</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.WindAcceptable, new { @class = "form-check-input" })
                            <label class="form-check-label">Wind Acceptable</label>
                        </div>
                    </div>
                    </section>

                <!-- ════════════════════════════════════════════════════
               SECTION: Inspected Area
               ════════════════════════════════════════════════════ -->
                <section class="card permit-card">
                    @Html.ValidationMessage("Inspected Area", "", new { @class = "text-danger" })
                    <div class="section-title">
                        The following areas / items have been inspected by issuer and receiver
                    </div>
                    <div class="row">

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.GroundCondition, new { @class = "form-check-input" })
                            <label class="form-check-label">Ground Condition</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.DangerWarningSign, new { @class = "form-check-input" })
                            <label class="form-check-label">Danger/Warning Sign</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.SignalMan, new { @class = "form-check-input" })
                            <label class="form-check-label">Signal Man</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.SafetyBarriers, new { @class = "form-check-input" })
                            <label class="form-check-label">Safety Barriers</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.TagLine, new { @class = "form-check-input" })
                            <label class="form-check-label">Tag Line</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.Rigger, new { @class = "form-check-input" })
                            <label class="form-check-label">Rigger</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.OutriggerExtended, new { @class = "form-check-input" })
                            <label class="form-check-label">Outrigger (Extended)</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.Lighting, new { @class = "form-check-input" })
                            <label class="form-check-label">Lighting</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.OutriggerPad, new { @class = "form-check-input" })
                            <label class="form-check-label">Outrigger Pad</label>
                        </div>

                        <div class="col-md-4 form-check">
                            @Html.CheckBoxFor(m => m.SpreaderBeam, new { @class = "form-check-input" })
                            <label class="form-check-label">Spreader Beam</label>
                        </div>

                        <div class="col-md-4 form-check">
                                @Html.CheckBoxFor(m => m.ManMaterialBasketCertified, new { @class = "form-check-input" })
                            <label class="form-check-label">Man Material Basket (Certified)</label>
                        </div>
                    </div>
                </section>

                <!-- ═══════════════════════════════════════════════════
                 SECTION: PPE
              ════════════════════════════════════════════════════ -->
                <section class="card permit-card">
                    @Html.ValidationMessage("PPE", "", new { @class = "text-danger" })
                    <div class="section-title">
                        PPE <span class="required-star">*</span>
                    </div>
                    <div class="row">
                            <div class="col-md-3">@Html.CheckBoxFor(m => m.PPEHelmet) <label>Helmet</label></div>
                            <div class="col-md-3">@Html.CheckBoxFor(m => m.PPEShoes) <label>Safety Shoes</label></div>
                            <div class="col-md-3">@Html.CheckBoxFor(m => m.PPEGloves) <label>Mechanical Gloves</label></div>
