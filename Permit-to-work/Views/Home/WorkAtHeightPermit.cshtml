@model Permit_to_work.Models.WorkAtHeightPermit

@{
    ViewData["Title"] = "WorkAtHeightPermit";
}
<form asp-action="WorkAtHeightPermit" method="post" class="container my-4 px-2">



    <link rel="stylesheet" href="~/css/Height.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <div class="card shadow">
        <section class="card permit-card">
            <div class="section-title">
                <div class="card-header text-center fw-bold">WORK AT HEIGHT PERMIT</div>
            </div>
        </section>

        <div class="card-body">
       
            <!-- ════════════════════════════════════════════════════
               SECTION: BASIC DETAILS
            ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                <div class="section-title">Basic Details</div>
                @Html.ValidationMessage("BasicDetails", "", new { @class = "text-danger" })
                <div class="row g-3">
                    <div class="col-md-3">
                        <label>
                            Unit <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.Unit, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Contractor <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.ContractorTeam, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ContractorTeam, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Location <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.Location, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            No. of Workmen <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.NoOfWorkmen, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NoOfWorkmen, "", new { @class = "text-danger" })
                    </div>
                </div>
            </section>

            <!-- ════════════════════════════════════════════════════
               SECTION: DATE & TIME
            ════════════════════════════════════════════════════ -->

            <section class="card permit-card">
                <div class="section-title mt-4">
                    Date & Time
                </div>
                @Html.ValidationMessage("Dates", "", new { @class = "text-danger" })
                <div class="row g-3">
                    <div class="col-md-3">
                        <label>
                            Starting Date <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Starting time <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.StartTime, new { type = "time", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.StartTime, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Expected Date <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>
                            Expected time <span class="required-star">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.EndTime, new { type = "time", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.EndTime, "", new { @class = "text-danger" })
                    </div>
                </div>
            </section>

            <!-- ════════════════════════════════════════════════════
               SECTION: WORK TYPE
            ════════════════════════════════════════════════════ -->

            <section class="card permit-card">
                @Html.ValidationMessage("WorkType", "", new { @class = "text-danger" })
                <div class="section-title">
                    Work Type <span class="required-star">*</span>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="Scaffolding" />
                        @Html.CheckBoxFor(m => m.Scaffolding, new { @class = "form-check-input" })
                        <label class="form-check-label">Scaffolding</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="Ladder" />
                        @Html.CheckBoxFor(m => m.Ladder, new { @class = "form-check-input" })
                        <label class="form-check-label">Ladder</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="AerialLift" />
                        @Html.CheckBoxFor(m => m.AerialLift, new { @class = "form-check-input" })
                        <label class="form-check-label">Aerial Lift</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="RoofWork" />
                        @Html.CheckBoxFor(m => m.RoofWork, new { @class = "form-check-input" })
                        <label class="form-check-label">Roof Work</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <label>Others</label>
                    <input type="text" name="OtherWork" class="form-control" />
                </div>
            </section>


            <!-- ════════════════════════════════════════════════════
               SECTION: WORK DESCRIPTION
            ════════════════════════════════════════════════════ -->

            <section class="card permit-card">
                <label>Work Description</label>
                @Html.TextAreaFor(m => m.WorkDescription, 3, 100, new { @class = "form-control" })
            </section>

            <!-- ════════════════════════════════════════════════════
               SECTION: TOOLS & EQUIPMENTS
          ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                <label>Tools / Equipment to be used</label>
                @Html.TextAreaFor(m => m.ToolsEquipment, 3, 100, new { @class = "form-control" })
            </section>

            <!-- ════════════════════════════════════════════════════
               SECTION: RISK
            ════════════════════════════════════════════════════ -->

            <section class="card permit-card">
                @Html.ValidationMessage("Risk", "", new { @class = "text-danger" })
                <div class="section-title">
                    Identify Risk Associated with Work at Height <span class="required-star">*</span>
                </div>
                <div class="row">

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.FallfromHeight, new { @class = "form-check-input" })
                        <label class="form-check-label">Fall from Height</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.AdverseWeather, new { @class = "form-check-input" })
                        <label class="form-check-label">Adverse Weather</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.FlyingParticles, new { @class = "form-check-input" })
                        <label class="form-check-label">Flying Particles</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.MovingVehicleEquipment, new { @class = "form-check-input" })
                        <label class="form-check-label">Moving Vehicle/Equipment</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.FallingDebrisObjects, new { @class = "form-check-input" })
                        <label class="form-check-label">Falling Debris/Objects</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.ProtrudingObjectsparts, new { @class = "form-check-input" })
                        <label class="form-check-label">Protruding Objects/parts/parts</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.TrippingSlipping, new { @class = "form-check-input" })
                        <label class="form-check-label">Tripping/Slipping</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.FaultyEquipmentMaterial, new { @class = "form-check-input" })
                        <label class="form-check-label">Faulty Equipment/Material</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.FragileSurfaceRoof, new { @class = "form-check-input" })
                        <label class="form-check-label">Fragile Surface/Roof</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.WorkUnderBelow, new { @class = "form-check-input" })
                        <label class="form-check-label">Work Under Below</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.NearOverheadLines, new { @class = "form-check-input" })
                        <label class="form-check-label">Near Overhead Lines</label>
                    </div>

                    <div class="col-md-4 form-check">
                        @Html.CheckBoxFor(m => m.NearEnergizedEquipment, new { @class = "form-check-input" })
                        <label class="form-check-label">Near Energized Equipment</label>
                    </div>

                    <div class="col-md-3">
                        <label>Other (specify):</label>
                        @Html.TextBoxFor(m => m.OtherRiskControl, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.OtherRiskControl, "", new { @class = "text-danger" })
                    </div>
                </div>
            </section>
