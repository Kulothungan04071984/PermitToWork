            <!-- ════════════════════════════════════════════════════
              SECTION: INSURANCE COPY
         ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Insurance", "", new { @class = "text-danger" })
                <div class="section-title">
                    Insurance copy available for workmen <span class="required-star">*</span>
                </div>

                <div class="d-flex gap-4">

                    <div>
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.WC, new { @class = "form-check-input", id = "wc" })
                            <label class="form-check-label" for="wc">WC</label>
                        </div>

         
                        @* <div id="wcUpload" style="display:none; margin-top:5px;">
                            <input type="file" name="WCFile" id="wcFile" class="form-control form-control-sm" style="background:#ffb3b3; border:1px solid #000;" />
                        </div> *@
                    </div>

                    <div>
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.ESI, new { @class = "form-check-input", id = "esi" })
                            <label class="form-check-label" for="esi">ESI</label>
                        </div>

                        @* <div id="esiUpload" style="display:none; margin-top:5px;">
                            <input type="file" name="ESIFile" id="esiFile" class="form-control form-control-sm" style="background:#ffb3b3; border:1px solid #000;" />
                        </div> *@
                    </div> 

                    </div>
                <div class="col-md-3">
                    <label>Other (specify):</label>
                    @Html.TextBoxFor(m => m.OtherInsurance, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.OtherInsurance, "", new { @class = "text-danger" })
                </div>
            </section>

            <!-- ════════════════════════════════════════════════════
              SECTION: AUTHORIZATION
            ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                <div class="section-title">
                    Issue and Acceptance 
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label>Raised By</label>
                        @Html.TextBoxFor(m => m.RaisedBy, new { @class = "form-control" })
                    </div>

                    <div class="col-md-3">
                        <label>Receiver Date</label>
                        @Html.TextBoxFor(m => m.DepartmentIncharge, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label>Permit Issuer name</label>
                        @Html.TextBoxFor(m => m.Facility, new { @class = "form-control" })
                    </div>

                    <div class="col-md-3">
                        <label>Issuer Date</label>
                        @Html.TextBoxFor(m => m.Safety, new { @class = "form-control"})
                    </div>
                </div>

            </section>

            <!-- ════════════════════════════════════════════════════
              SECTION: SUSPENSION
            ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("Suspension", "", new { @class = "text-danger" })
                <div class="section-title">
                    Suspension <span class="required-star">*</span>
                </div>

                <p class="mb-2">This permit is suspended, area/equipment is not safe to use</p>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label>Name</label>
                        @Html.TextBoxFor(m => m.SuspensionName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.SuspensionName, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3">
                        <label>Date</label>
                        @Html.TextBoxFor(m => m.SuspensionSignatureDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.SuspensionSignatureDate, "", new { @class = "text-danger" })
                    </div>
                </div>
            </section>

            <!-- ════════════════════════════════════════════════════
              SECTION: APPROVER DETAILS
             ════════════════════════════════════════════════════ -->
            <section class="card permit-card">
                @Html.ValidationMessage("ApproverDetails", "", new { @class = "text-danger" })
                <div class="section-title">
                    Approver Details<span class="required-star">*</span>
                </div>

                <div class="row">
                    <div class="col-lg-3">
                        <label>
                            Approver One Email <span class="required-star">*</span>
                        </label>

                        @Html.TextBoxFor(m => m.ApproverOne, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ApproverOne, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-lg-3">
                        <label>Approver Two Email</label>
                        @Html.TextBoxFor(m => m.ApproverTwo, new { @class = "form-control" })
                    </div>

                    <div class="col-lg-3">
                        <label>Approver Three Email</label>
                        @Html.TextBoxFor(m => m.ApproverThree, new { @class = "form-control" })
                    </div>

                    <div class="col-lg-3">
                        <label>Approver Four Email</label>
                        @Html.TextBoxFor(m => m.ApproverFour, new { @class = "form-control" })
                    </div>
                </div>
            </section>

            <!-- BUTTONS -->
            <div class="text-center no-print mb-5">
                <button type="submit" class="btn btn-success px-4">Save</button>
                <button type="button" onclick="window.print()" class="btn btn-secondary px-4 ms-2">Print</button>
            </div>

        </div>
    </div>

</form>

<style>
    .required-star {
        color: darkred;
    }
</style>

<script>
    @section Scripts{
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    $(document).ready(function () {
    $('#hdHotwork, #hdLiftingOperations,#hdElectricalIsolation,#hdworkPermitForm').hide();
    });
</script>

